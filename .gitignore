# Dependencies
node_modules/

# Electron build output
dist/

# PWA build output (由 npm run pwa:build 生成，服务器自行构建后发布)
pwa-dist/

# Python build artifacts
# ⚠️ 这些规则原本指向项目根目录下的 music-player/ 与 foreground_inspection/，
#    它们早已归档到 deprecated/ 下 → 规则已同步（否则规则形同虚设）。
#    注意：deprecated/ 下**已跟踪的 .exe 仍保留**（历史存档，见 deprecated/README.md）；
#    被移出版本控制的是 PyInstaller **构建中间产物**（build/、__pycache__/，约 44MB）。
deprecated/music-player/build/
deprecated/music-player/dist/
deprecated/music-player/__pycache__/
deprecated/music-player/*.pyc
deprecated/foreground_inspection/build/
deprecated/foreground_inspection/dist/
deprecated/foreground_inspection/__pycache__/
deprecated/foreground_inspection/*.pyc
deprecated/foreground_inspection/api_config.json

# 根目录的 music-player/ 现在只承载**内置音乐资源**（由 Rust 端读取，构建时复制到 src-tauri/resources/）
# 目录整体忽略、只放行 3 首内置曲与元数据 —— 避免应用运行时下载的歌误入库
music-player/music/
!music-player/music/番茄小宇宙 - 番茄钟.mp3
!music-player/music/番茄倒数快一点 - 番茄钟.mp3
!music-player/music/Tick Tock, Take Control - 番茄钟.mp3
!music-player/music/tags.json
music-player/*.spec
music-player/*.bat

# Python build artifacts (server planning)
server-planning/__pycache__/
server-planning/*.pyc

# Python cache (root)
__pycache__/
*.pyc


