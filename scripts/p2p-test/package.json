{
  "name": "pomosolo-p2p-test",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "PomoSolo P2P 实测工具集：① 传输层（WebRTC 打洞 + DataChannel 直连 + 速率）② 应用层多客户端传歌（真协议、真服务器、免启动多个客户端）",
  "scripts": {
    "auth": "node auth.js",
    "peer": "node peer.js",
    "transfer": "node transfer-test.mjs --scenario all",
    "transfer:fanout": "node transfer-test.mjs --scenario relay-fanout",
    "run:local": "node run.js --mode local",
    "run:docker": "node run.js --mode docker"
  },
  "dependencies": {
    "werift": "^0.24.2",
    "ws": "^8.18.0"
  }
}
