{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PomoSolo",
  "version": "4.6.5",
  "identifier": "com.pomosolo.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1431",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PomoSolo",
        "width": 520,
        "height": 560,
        "resizable": false,
        "center": true,
        "minimizable": true,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false
      },
      {
        "label": "garden",
        "title": "菜园子",
        "url": "garden.html",
        "width": 400,
        "height": 520,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://api.deepseek.com",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/music/"
    ],
    "externalBin": [],
    "copyright": "",
    "category": "Productivity",
    "shortDescription": "番茄钟专注应用",
    "longDescription": "PomoSolo - 一款功能丰富的番茄钟专注应用，支持前台检测、音乐播放、菜园子游戏、自习室等",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwRUZERjE5RURCNTIxRkIKUldUN0liWHRHZC92Y0U1NnoxUXBGWFl1aG5BdVkwY2c4eHBEN1h5dm1qQlVLSzdmQWRWQmdqS3MK",
      "endpoints": [
        "https://github.com/liaowenqi123/PomoSolo/releases/latest/download/latest.json"
      ]
    }
  }
}
