{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PomoSolo",
  "version": "4.0.0",
  "identifier": "com.pomosolo.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PomoSolo",
        "width": 520,
        "height": 560,
        "resizable": false,
        "center": true,
        "minimizable": true,
        "maximizable": false,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; font-src 'self' data:",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "Productivity",
    "shortDescription": "番茄钟专注应用",
    "longDescription": "PomoSolo - 一款功能丰富的番茄钟专注应用，支持前台检测、音乐播放、菜园子游戏、自习室等"
  }
}
